# A.S.H -- offline configuration.
# Written by install_offline.ps1. Everything here keeps the process on this box.

# ---- LLM backend -----------------------------------------------------------
# "ollama" = fully local. Do not change this on an air-gapped machine;
# "openrouter" and "local" both expect a reachable HTTP endpoint.
ASH_LLM_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=__MODEL__

# ---- HuggingFace: local cache only -----------------------------------------
# Without these, transformers and sentence-transformers try to revalidate the
# snapshot against huggingface.co on every load and stall until the connect
# timeout expires. With them, they read the cache and return immediately.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# ---- Model names ASH loads from the local HF cache -------------------------
ASH_EMBED_MODEL=all-MiniLM-L6-v2
ASH_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# ---- Paths -----------------------------------------------------------------
# Where intents.json and the embedding cache live.
ASH_AI_BASE=__ASH_DIR__\data

# ---- Feature switches ------------------------------------------------------
# Associative concept layer. 0 disables it; the brain falls back to raw
# embedding prediction and classifier-only routing.
ASH_CONCEPTS=1

# ---- Deliberately NOT set --------------------------------------------------
# OPENROUTER_API_KEY / OPENROUTER_MODEL are omitted on purpose. If they are
# present AND ASH_LLM_MODE=openrouter, ASH will try to reach the internet.
